SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-or-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Generate a strong value with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Used only on the server to encrypt user-supplied AI credentials at rest.
# Generate independently with: openssl rand -base64 32
AI_API_ENCRYPTION_SECRET=replace-with-a-separate-strong-random-value
# Public canonical URL used in notification emails and password recovery redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional opt-in campaign/entity notification email delivery through Resend.
RESEND_API_KEY=re_replace-with-your-resend-api-key
NOTIFICATION_EMAIL_FROM=Lorekeeper <notifications@example.com>
